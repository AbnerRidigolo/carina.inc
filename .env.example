# CARINA — variáveis de ambiente. Copie para .env e ajuste. NUNCA comite segredos reais.

# ── Aplicação ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Origem permitida no CORS (frontend React/Vite)
WEB_ORIGIN=http://localhost:5173
# Nível de log do pino (opcional): trace|debug|info|warn|error
# LOG_LEVEL=info

# ── Bancos de dados ──────────────────────────────────────────
# Papel de runtime (sem BYPASSRLS)
DATABASE_URL=postgres://carina_app:carina_app_dev@localhost:5432/carina
# Papel de migrações (DDL) — usado só pelo migrator
MIGRATION_DATABASE_URL=postgres://carina_migrator:carina_migrator_dev@localhost:5432/carina
REDIS_URL=redis://localhost:6379
# Senhas usadas pelo docker compose ao criar os papéis (docker/postgres/init.sh) — devem
# bater com as URLs acima. Só valem na primeira subida (volume vazio).
POSTGRES_PASSWORD=postgres
CARINA_MIGRATOR_PASSWORD=carina_migrator_dev
CARINA_APP_PASSWORD=carina_app_dev

# ── Testes de integração/E2E ─────────────────────────────────
# Superusuário de um Postgres com pgvector (o harness cria papéis e um banco por execução).
# Sem estas variáveis, os testes sobem containers via Testcontainers (exige Docker).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# TEST_REDIS_URL=redis://localhost:6379

# ── LLM ──────────────────────────────────────────────────────
# mock = respostas determinísticas, sem chamadas externas; live = provedores reais
LLM_MODE=mock
# Obrigatória quando LLM_MODE=live
OPENROUTER_API_KEY=
# Fallback opcional
GROQ_API_KEY=
# Embeddings (NeMo Retriever)
NVIDIA_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Regras de negócio ────────────────────────────────────────
# Taxa de execução (%)
EXECUTION_FEE_PCT=0.5
# Requisições por minuto padrão por tenant
DEFAULT_RPM=60
# Validade das aprovações pendentes (horas)
APPROVAL_TTL_HOURS=24
