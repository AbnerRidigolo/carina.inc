# CARINA — variáveis de ambiente. Copie para .env e ajuste. NUNCA comite segredos reais.

# ── Aplicação ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Única origem aceita pelo CORS da API (o frontend React/Vite). Sem curinga.
WEB_ORIGIN=http://localhost:5173
# Nível de log do pino: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info
# Workers de fundo neste processo (SyncWorker e ResumeWorker no stream jobs, ReconciliationJob da
# inbox): true|false. `pnpm --filter @carina/api start` (main.ts) segue esta variável — true roda
# tudo num processo só, bom para desenvolvimento. O main.worker.ts força true. No docker compose a
# API sobe com false e os workers rodam no serviço `worker`.
WORKERS_ENABLED=true
# Heap máxima (MB, 64–16384) da thread que lê os arquivos importados. Estourar → limit_exceeded.
# Planilhas de poucos MB podem precisar de mais de 512 MB; suba só com memória sobrando no worker.
IMPORT_PARSE_MAX_HEAP_MB=512
# Vida máxima de uma conexão WebSocket do chat (ms, 1000–86400000). Ao vencer, o servidor fecha
# com 4401 e o cliente emite um ticket novo.
WS_MAX_CONNECTION_MS=1800000
# Cache da revalidação da chave antes de cada turno de chat (ms, 0–60000): a janela máxima entre
# revogar a chave/suspender o tenant e o efeito num socket aberto.
API_KEY_REVALIDATE_TTL_MS=60000

# ── Bancos de dados ──────────────────────────────────────────
# Papel de runtime (sem BYPASSRLS)
DATABASE_URL=postgres://carina_app:carina_app_dev@localhost:5432/carina
# Papel de migrações (DDL) — usado só por `prisma migrate deploy` e pelo seed. A API e o worker NÃO
# precisam dela (no docker compose eles nem a recebem).
MIGRATION_DATABASE_URL=postgres://carina_migrator:carina_migrator_dev@localhost:5432/carina
REDIS_URL=redis://localhost:6379
# Senhas usadas pelo docker compose ao criar os papéis (docker/postgres/init.sh) — devem
# bater com as URLs acima. Só valem na primeira subida (volume vazio).
POSTGRES_PASSWORD=postgres
CARINA_MIGRATOR_PASSWORD=carina_migrator_dev
CARINA_APP_PASSWORD=carina_app_dev

# ── Seed de demo (`pnpm --filter @carina/api seed`, depois do build; serviço `seed` do compose) ──
# Chaves do tenant `demo` (formato sk-live- + 32 base62). Vazias = os padrões FIXOS de demo:
#   DEMO_APP_KEY      → sk-live-demoapp0000000000000000000000000      (escopos chat, data:write)
#   DEMO_APPROVER_KEY → sk-live-demoapprover00000000000000000000      (escopos chat, inbox:decide)
# Esses padrões estão no repositório: são SÓ para a demo local, nunca para um ambiente exposto.
DEMO_APP_KEY=
DEMO_APPROVER_KEY=
# Com NODE_ENV=production o seed RECUSA as chaves fixas acima, a menos que esta liberação seja
# true (o docker compose de demo liga de propósito). Em qualquer outro ambiente, deixe vazia e
# defina chaves novas.
SEED_ALLOW_DEMO_KEYS=

# ── Testes de integração/E2E ─────────────────────────────────
# Superusuário de um Postgres com pgvector (o harness cria um banco por execução e os papéis que
# faltarem, com CARINA_MIGRATOR_PASSWORD/CARINA_APP_PASSWORD acima). Papéis existentes nunca são
# alterados: se a senha deles não bater com essas variáveis, os testes param com instruções.
# Sem estas variáveis, os testes sobem containers via Testcontainers (exige Docker).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# TEST_REDIS_URL=redis://localhost:6379
# Opcional (PostgreSQL >= 15, só com TEST_DATABASE_URL): cria o banco de teste com collation ICU,
# para reproduzir localmente a ordenação de texto do CI (en_US) em vez da binária C.UTF-8.
# TEST_DB_ICU_LOCALE=en-US

# ── LLM ──────────────────────────────────────────────────────
# mock = respostas determinísticas, sem chamadas externas; live = provedores reais
LLM_MODE=mock
# Obrigatória quando LLM_MODE=live
OPENROUTER_API_KEY=
# Fallback opcional
GROQ_API_KEY=
# Embeddings (NeMo Retriever)
NVIDIA_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Mercado (cotações B3 e indicadores macro) ────────────────
# mock = dados determinísticos, sem chamadas externas; live = brapi.dev + BCB SGS.
# Obrigatória com NODE_ENV=production.
MARKET_MODE=mock
# Token da brapi.dev (opcional; sem ele só PETR4, MGLU3, VALE3 e ITUB4 respondem, a 20 req/min
# por IP — conferido na documentação da brapi em 2026-11-14). Com token, BRAPI_BASE_URL tem de ser https.
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api
BCB_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie
# Timeout de cada chamada ao provedor (ms)
MARKET_FETCH_TIMEOUT_MS=8000
# Tamanho máximo da resposta do provedor (bytes)
MARKET_MAX_RESPONSE_BYTES=1048576
# Símbolos por requisição de cotação à brapi (1..20). O padrão 1 cabe em todos os planos
# (Gratuito 1, Startup 10, Pro 20 ativos por requisição, conferido em 2026-11-14).
MARKET_BRAPI_MAX_SYMBOLS_PER_CALL=1
# Requisições simultâneas à brapi por processo (1..10; Gratuito aceita 1 por conta)
MARKET_PROVIDER_CONCURRENCY=1
# Orçamento global de requisições ao provedor por minuto (janela fixa no Redis, por MARKET_MODE).
# Rotas /api/market/*: esgotado → 503 com Retry-After, sem cobrança (1..10000). Uma consulta de N
# símbolos fora do cache consome ceil(N / MARKET_BRAPI_MAX_SYMBOLS_PER_CALL).
MARKET_PROVIDER_MAX_CALLS_PER_MIN=30
# Orçamento separado para o preço das ordens (priceFor); esgotado → ordem recusada (1..10000)
MARKET_PRICE_MAX_CALLS_PER_MIN=30
# Orçamento separado para o monitor de carteira (nunca esgota o das rotas nem o do preço);
# esgotado → o ciclo para de cotar e o rodízio retoma no seguinte (1..10000)
MARKET_MONITOR_MAX_CALLS_PER_MIN=10
# Intervalo entre ciclos do monitor de carteira, em ms (mínimo 60000 = 1 min; padrão 10 min)
MONITOR_INTERVAL_MS=600000
# Intervalo entre ciclos da agenda dos AOPs (procedimentos de agentes), em ms (mínimo 60000 = 1 min;
# padrão 5 min). Um disparo vencido roda no primeiro ciclo depois do horário agendado (São Paulo)
AOP_TICK_MS=300000
# Símbolos cotados por ciclo do monitor, em rodízio sobre as carteiras (1..200). Não passe de
# MARKET_MONITOR_MAX_CALLS_PER_MIN × MARKET_BRAPI_MAX_SYMBOLS_PER_CALL, senão o ciclo termina esgotado
MONITOR_MAX_SYMBOLS_PER_TICK=10
# Variação diária (%, em módulo) que dispara o alerta de carteira (inteiro, 1..50)
MONITOR_MOVE_THRESHOLD_PCT=5
# Idade máxima de uma cotação com o mercado aberto (ms). Precisa ser pelo menos o atraso do plano
# da brapi (~30 min no Gratuito, ~15 no Startup, ~5 no Pro; use ~35 min = 2100000 no Gratuito):
# abaixo disso o live recusa toda ordem em pregão como price_stale (falha fechada).
MARKET_QUOTE_MAX_AGE_MS=300000
# Idade máxima (dias) de uma cotação com o mercado fechado
MARKET_CLOSED_MAX_AGE_DAYS=5

# ── Regras de negócio ────────────────────────────────────────
# Taxa de execução (%)
EXECUTION_FEE_PCT=0.5
# Validade das aprovações pendentes (horas)
APPROVAL_TTL_HOURS=24
