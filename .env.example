# ─────────────────────────────────────────────────────────────────────────────
# CARINA — variáveis de ambiente. Copie para `.env` e preencha. NUNCA comite `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Camada de modelos (LiteLLM) ──────────────────────────────────────────────
# NVIDIA NIM (primário) — chave começa com "nvapi-". Free tier ~40 RPM.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq (fallback) — latência baixíssima, OpenAI-compatible.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── FalkorDB Cloud (Free Tier) — connection string do serviço gerenciado ──────
# OBS: instância free é PARADA após 1 dia ociosa e DELETADA após 7. O Monitor
# Agent (Modal) mantém uso contínuo. Ver docs/DEPLOYMENT.md.
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# ── Operacional ──────────────────────────────────────────────────────────────
CARINA_ENV=dev
LOG_LEVEL=INFO
# Caminho opcional para o YAML de roteamento de modelos (default: carina/config/models.yaml)
CARINA_MODELS_CONFIG=

# ── B2B (Agent API) ──────────────────────────────────────────────────────────
# Chaves de API por tenant: "chave:tenant_id:Nome;chave2:tenant2".
# Tenant ids NÃO podem conter "__" (separador de namespace).
# Sem chaves a API falha fechada (tudo 401), exceto em dev com o opt-in abaixo.
CARINA_API_KEYS=
# Tenant "dev" implícito sem chave de API — APENAS para desenvolvimento local.
CARINA_ALLOW_DEV_TENANT=1
# Limites por tenant: "tenant:rpm:resoluções_mês;tenant2:rpm" (quota 0 = ilimitada).
CARINA_TENANT_LIMITS=
CARINA_DEFAULT_RPM=60
CARINA_DEFAULT_MONTHLY_QUOTA=0

# ── Integrações (F3/F4 — opcionais até serem usadas) ─────────────────────────
# Open Finance via agregador Pluggy (https://dashboard.pluggy.ai → API keys).
# Sandbox gratuito para desenvolvimento; trocar de provedor = nova classe
# OpenFinanceProvider, sem tocar no resto do código.
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
OPEN_FINANCE_BASE_URL=https://api.pluggy.ai
WHATSAPP_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
