# ─────────────────────────────────────────────────────────────────────────────
# CARINA — variáveis de ambiente. Copie para `.env` e preencha. NUNCA comite `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Camada de modelos (LiteLLM) ──────────────────────────────────────────────
# NVIDIA NIM (primário) — chave começa com "nvapi-". Free tier ~40 RPM.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Groq (fallback) — latência baixíssima, OpenAI-compatible.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── FalkorDB Cloud (Free Tier) — connection string do serviço gerenciado ──────
# OBS: instância free é PARADA após 1 dia ociosa e DELETADA após 7. O Monitor
# Agent (Modal) mantém uso contínuo. Ver docs/DEPLOYMENT.md.
FALKORDB_HOST=
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# ── Operacional ──────────────────────────────────────────────────────────────
CARINA_ENV=dev
LOG_LEVEL=INFO
# Caminho opcional para o YAML de roteamento de modelos (default: carina/config/models.yaml)
CARINA_MODELS_CONFIG=

# ── B2B (Agent API) ──────────────────────────────────────────────────────────
# Chaves de API por tenant: "chave:tenant_id:Nome;chave2:tenant2". Sem chaves,
# dev usa um tenant implícito e PRODUÇÃO REJEITA TUDO (falha fechada).
CARINA_API_KEYS=

# ── Integrações (F3/F4 — opcionais até serem usadas) ─────────────────────────
OPEN_FINANCE_CLIENT_ID=
OPEN_FINANCE_CLIENT_SECRET=
WHATSAPP_TOKEN=
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
