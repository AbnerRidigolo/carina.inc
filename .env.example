# CARINA — variáveis de ambiente. Copie para .env e ajuste. NUNCA comite segredos reais.

# ── Aplicação ────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Única origem aceita pelo CORS da API (o frontend React/Vite). Sem curinga.
WEB_ORIGIN=http://localhost:5173
# Nível de log do pino: trace|debug|info|warn|error|fatal|silent
LOG_LEVEL=info
# Workers de fundo neste processo (SyncWorker e ResumeWorker no stream jobs, ReconciliationJob da
# inbox): true|false. `pnpm --filter @carina/api start` (main.ts) segue esta variável — true roda
# tudo num processo só, bom para desenvolvimento. O main.worker.ts força true. No docker compose a
# API sobe com false e os workers rodam no serviço `worker`.
WORKERS_ENABLED=true
# Vida máxima de uma conexão WebSocket do chat (ms, 1000–86400000). Ao vencer, o servidor fecha
# com 4401 e o cliente emite um ticket novo.
WS_MAX_CONNECTION_MS=1800000
# Cache da revalidação da chave antes de cada turno de chat (ms, 0–60000): a janela máxima entre
# revogar a chave/suspender o tenant e o efeito num socket aberto.
API_KEY_REVALIDATE_TTL_MS=60000

# ── Bancos de dados ──────────────────────────────────────────
# Papel de runtime (sem BYPASSRLS)
DATABASE_URL=postgres://carina_app:carina_app_dev@localhost:5432/carina
# Papel de migrações (DDL) — usado só por `prisma migrate deploy` e pelo seed. A API e o worker NÃO
# precisam dela (no docker compose eles nem a recebem).
MIGRATION_DATABASE_URL=postgres://carina_migrator:carina_migrator_dev@localhost:5432/carina
REDIS_URL=redis://localhost:6379
# Senhas usadas pelo docker compose ao criar os papéis (docker/postgres/init.sh) — devem
# bater com as URLs acima. Só valem na primeira subida (volume vazio).
POSTGRES_PASSWORD=postgres
CARINA_MIGRATOR_PASSWORD=carina_migrator_dev
CARINA_APP_PASSWORD=carina_app_dev

# ── Seed de demo (`pnpm --filter @carina/api seed`, depois do build; serviço `seed` do compose) ──
# Chaves do tenant `demo` (formato sk-live- + 32 base62). Vazias = os padrões FIXOS de demo:
#   DEMO_APP_KEY      → sk-live-demoapp0000000000000000000000000      (escopos chat, data:write)
#   DEMO_APPROVER_KEY → sk-live-demoapprover00000000000000000000      (escopos chat, inbox:decide)
# Esses padrões estão no repositório: são SÓ para a demo local, nunca para um ambiente exposto.
DEMO_APP_KEY=
DEMO_APPROVER_KEY=
# Com NODE_ENV=production o seed RECUSA as chaves fixas acima, a menos que esta liberação seja
# true (o docker compose de demo liga de propósito). Em qualquer outro ambiente, deixe vazia e
# defina chaves novas.
SEED_ALLOW_DEMO_KEYS=

# ── Testes de integração/E2E ─────────────────────────────────
# Superusuário de um Postgres com pgvector (o harness cria um banco por execução e os papéis que
# faltarem, com CARINA_MIGRATOR_PASSWORD/CARINA_APP_PASSWORD acima). Papéis existentes nunca são
# alterados: se a senha deles não bater com essas variáveis, os testes param com instruções.
# Sem estas variáveis, os testes sobem containers via Testcontainers (exige Docker).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# TEST_REDIS_URL=redis://localhost:6379
# Opcional (PostgreSQL >= 15, só com TEST_DATABASE_URL): cria o banco de teste com collation ICU,
# para reproduzir localmente a ordenação de texto do CI (en_US) em vez da binária C.UTF-8.
# TEST_DB_ICU_LOCALE=en-US

# ── LLM ──────────────────────────────────────────────────────
# mock = respostas determinísticas, sem chamadas externas; live = provedores reais
LLM_MODE=mock
# Obrigatória quando LLM_MODE=live
OPENROUTER_API_KEY=
# Fallback opcional
GROQ_API_KEY=
# Embeddings (NeMo Retriever)
NVIDIA_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Regras de negócio ────────────────────────────────────────
# Taxa de execução (%)
EXECUTION_FEE_PCT=0.5
# Requisições por minuto padrão por tenant
DEFAULT_RPM=60
# Validade das aprovações pendentes (horas)
APPROVAL_TTL_HOURS=24
