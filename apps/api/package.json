{
  "name": "@carina/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/main.worker.js",
    "seed": "node --env-file-if-exists=../../.env dist/seed/seed.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:int": "vitest run --project int",
    "test:e2e": "vitest run --project e2e",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@carina/shared": "workspace:*",
    "@langchain/core": "1.3.1",
    "@langchain/groq": "1.3.1",
    "@langchain/langgraph": "1.6.0",
    "@langchain/langgraph-checkpoint": "1.2.2",
    "@langchain/langgraph-checkpoint-postgres": "1.1.2",
    "@langchain/openai": "1.7.1",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/platform-ws": "12.4.2",
    "@nestjs/websockets": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ioredis": "5.10.1",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@testcontainers/postgresql": "12.2.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1"
  }
}
