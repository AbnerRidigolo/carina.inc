    "test:e2e": "vitest run --project e2e --passWithNoTests"
  },
  "dependencies": {
    "@carina/shared": "workspace:*",
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "nestjs-pino": "5.3.1",
    "nestjs-zod": "5.6.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
